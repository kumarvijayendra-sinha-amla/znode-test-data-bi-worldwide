  "testId": "tests/webstore/UserManagementPage/UserListSearchFilterSortTest.spec.ts > BMP-TC-61 - Verify applying a filter after a search shows the filter results instead of the search results",
  "scenario": {
    "summary": "Admin searches an Active Sales Rep, then filters Status = Deactivated; the filter result replaces the search result.",
    "steps": [
      "Sign in on the storefront login with testData.value('admin', 'userName') and the admin password (***)",
      "Open Header > Users (Administrator Users page) > Users tab",
      "Search a part of testData.value('rep', 'lastName')",
      "Select Status = Deactivated"
    ],
    "entitiesTouched": [
      "user_management",
      "market"
    ],
    "stateChanges": [],
    "assertions": [
      "rep (Active) is not listed",
      "repInactive is listed",
      "Every listed row carries the Deactivated tag"
    ],
    "evidence": [
      "Jira BMP-38 (Web Admins can search, filter, and sort the user list)",
      "AC9",
      "FSD User Allotment Management Tab > User Management Page > Users Management Tab > Search and Filter Behavior (Filters override search results)",
      "AIO BMP-TC-61 (title only; the export has no steps)",
      "Review: What the search field shows after the filter overrides it is not defined (analysis question 13)",
      "Review: not asserted: \"every listed row carries the Deactivated tag\". The grid on qa has no Role, Status or ASM column and no Admin / Super Admin / Deactivated tags (only name, email, shipper ID, market, allotments, Deactivate button); the test asserts list membership instead (test author, 2026-11-26)",
      "UI labels on qa (test author, 2026-11-26): tab \"Help/Contact Us\", \"Clear filters\", sort options \"Newest first\" / \"First name A - Z\", User Type option \"Sales Representative\""
    ],
    "confidence": "medium",
    "needsReview": true
  },
