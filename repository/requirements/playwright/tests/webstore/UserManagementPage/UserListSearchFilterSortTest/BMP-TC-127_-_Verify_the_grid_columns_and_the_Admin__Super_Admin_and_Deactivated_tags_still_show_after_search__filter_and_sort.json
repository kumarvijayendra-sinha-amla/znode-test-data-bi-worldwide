  "scenario": {
    "summary": "After search, filter and sort the grid keeps its columns and tags.",
    "steps": [
      "Sign in on the storefront login with testData.value('admin', 'userName') and the admin password (***)",
      "Open Header > Users (Administrator Users page) > Users tab",
      "Search the run's user tag",
      "Sort by First Name",
      "Select Status = Deactivated, then clear it"
    ],
    "entitiesTouched": [
      "pim_attribute_options",
      "user_management",
      "market"
    ],
    "stateChanges": [],
    "assertions": [
      "Columns Name, Email, Role, Status, Market, Shipper ID, Allotment Count, ASM are shown",
      "adminListed has the Admin tag, superAdminListed the Super Admin tag, repInactive the Deactivated tag",
      "rep's row shows its market and shipperId"
    ],
    "evidence": [
      "Jira BMP-38 (Web Admins can search, filter, and sort the user list)",
      "FSD User Grid",
      "AIO BMP-TC-127 (title only; the export has no steps)",
      "Review: Exact tag texts to confirm (FSD vs SRS)",
      "Review: not asserted: \"columns Role, Status, ASM\" and \"Admin, Super Admin, Deactivated tags\". The grid on qa has no Role, Status or ASM column and no Admin / Super Admin / Deactivated tags (only name, email, shipper ID, market, allotments, Deactivate button); the test asserts list membership instead (test author, 2026-11-26)",
      "UI labels on qa (test author, 2026-11-26): tab \"Help/Contact Us\", \"Clear filters\", sort options \"Newest first\" / \"First name A - Z\", User Type option \"Sales Representative\""
    ],
    "confidence": "medium",
