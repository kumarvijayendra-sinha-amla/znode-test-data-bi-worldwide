  "scenario": {
    "summary": "Admin applies the three filters, then Clear Filters; filters reset and the full list and count return. Runs serially.",
    "steps": [
      "Sign in on the storefront login with testData.value('admin', 'userName') and the admin password (***)",
      "Open Header > Users (Administrator Users page) > Users tab",
      "Read the total user count",
      "Select Market = market.marketName, User Type = Sales Rep, Status = Deactivated",
      "Click Clear Filters"
    ],
    "entitiesTouched": [
      "user_management",
      "market"
    ],
    "stateChanges": [],
    "assertions": [
      "Market, User Type and Status are back to their defaults",
      "Total user count equals the first reading",
      "rep and repInactive are listed (newest first)"
    ],
    "evidence": [
      "Jira BMP-38 (Web Admins can search, filter, and sort the user list)",
      "AC6",
      "FSD User Allotment Management Tab > User Management Page > Users Management Tab > [BA Addition] A Clear Filters option resets every filter",
      "Count tests run serially (default 2026-11-26)",
      "AIO BMP-TC-66 (title only; the export has no steps)",
      "UI labels on qa (test author, 2026-11-26): tab \"Help/Contact Us\", \"Clear filters\", sort options \"Newest first\" / \"First name A - Z\", User Type option \"Sales Representative\""
    ],
    "confidence": "medium"
  },
